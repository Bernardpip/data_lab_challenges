# Environnements Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Streamlit — un fichier de secrets ne se versionne jamais
.streamlit/secrets.toml

# Livrables reconstructibles : le zip se régénère depuis le dépôt
# (cf. scripts/faire_zip.py d'un défi)
*.zip

# ...mais un zip DÉPOSÉ dans un dossier de données est une ressource source,
# pas un livrable : il vient du portail et ne se régénère pas. La règle
# ci-dessus a écarté fsi-brut-geotiff.zip (76 Mo) au premier commit — un
# corpus amputé sans que rien ne le signale, exactement ce qu'un `.gitignore`
# large fait de pire.
!**/datasets/*.zip
!**/data/*.zip

# Systèmes de fichiers
.DS_Store
Thumbs.db

# Fichiers verrous bureautiques
~$*

# Outils locaux
.playwright-mcp/
.claude/
.vscode/

# ─── Le pilote est absorbé ──────────────────────────────────────────────────
# `challenge_archived/togo-formation-emploi` était un dépôt git à lui seul.
# Son `.git` a été retiré et ses fichiers vivent désormais ici : c'est de CE
# dépôt que Railway déploie, avec `challenge_archived/togo-formation-emploi`
# en dossier racine du service.
#
# Son dépôt d'origine (github.com/Bernardpip/togo-formation-emploi) reste en
# ligne et garde tout l'historique jusqu'au commit « Bascule sur le socle
# partagé » — c'est l'archive, elle ne reçoit plus rien.
